# =============================================================================
# ITAD Platform Environment Configuration (example)
# Copy this file to .env for docker-compose usage.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=itad
POSTGRES_PASSWORD=itad_dev_password
POSTGRES_DB=itad
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Backend ---
# Full SQLAlchemy URL (constructed from POSTGRES_* by docker-compose)
DATABASE_URL=postgresql+psycopg2://itad:itad_dev_password@postgres:5432/itad

# Security
SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALGORITHM=HS256

# CORS
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# App
PROJECT_NAME=ITAD Platform
API_V1_PREFIX=/api/v1
ENVIRONMENT=development

# Seed
SEED_ON_STARTUP=true
DEMO_PASSWORD=Demo123!

# --- Frontend ---
# For docker-compose the frontend uses relative /api which nginx proxies.
# For local dev (Vite) set to the FastAPI URL.
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/api/v1/ws
